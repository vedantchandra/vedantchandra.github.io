\ProvidesPackage{config/minimal-resume}

% margin
\usepackage[top=1in, bottom=1in, left=1in, right=1in]{geometry}

% minimal custom packages
\usepackage[T1]{fontenc}
\usepackage{fontspec}
\usepackage[babel=true]{microtype}
\usepackage[fontsize=10.75pt]{scrextend}
\usepackage{enumitem}
\usepackage[dvipsnames]{xcolor}
\definecolor{crimson}{rgb}{0.788, 0.0, 0.086}

\defaultfontfeatures{Ligatures=TeX}

% main font for the document
\setmainfont[Path=fonts/, BoldFont=CrimsonText-Bold,ItalicFont=CrimsonText-Italic]{CrimsonText-Roman}

% font sizes
\newcommand{\sizeone}{1.618em}
\newcommand{\sizetwo}{1.118em}
\newcommand{\sizethree}{1em}
\newcommand{\sizefour}{0.618em}
\newcommand{\sizefive}{0.382em}
\newcommand{\sizesix}{0.236em}

\definecolor{azure}{rgb}{0, 0.45, 0.81}

% line spaces
\newcommand{\linespaceone}{1}

\newenvironment{newitemize}
  {\fontsize{1em}{1em}\fontspec[Path = fonts/,LetterSpace= 0,BoldFont=CrimsonText-Bold]{CrimsonText-Roman}\itemize[nolistsep,topsep=0.35em,itemsep=\sizefive,labelsep=\sizefour,leftmargin=*]}
  {\enditemize}

\newenvironment{newitemizemain}
  {\fontsize{1em}{1em}\fontspec[Path = fonts/,LetterSpace=0,BoldFont=CrimsonText-Bold]{CrimsonText-Roman}\itemize[nolistsep,topsep=\sizefive,itemsep=\sizefive,labelsep=\sizefour,leftmargin=*]}
  {\enditemize}

\newcommand{\personal}[3]{
  \begin{center}
    % name
    {
      \fontsize{1.3em}{1.3em}\fontspec[Path = fonts/,LetterSpace=0]{CrimsonText-Roman}#1
    }\\
    % address
    \vspace{\sizefour}
    {
      \fontsize{\sizethree}{\sizethree}\fontspec[Path = fonts/,LetterSpace= 5]{CrimsonText-Roman}#2
    }\\
    % contact
    \vspace{\sizefive}
    {
      \fontsize{\sizethree}{\sizethree}\fontspec[Path = fonts/]{CrimsonText-Roman}#3
    }
  \end{center}
}

\newcommand{\chap}[2]{
  \vspace{0.5em}
  \raggedright
  \begin{addmargin}[\sizefive]{\sizefive}{
  {
  \fontsize{1.125em}{1.125em}\fontspec[Path = fonts/,LetterSpace=0]{CrimsonText-SemiBold}
  \textbf{\color{black} #1}
  }
  \vspace{\sizefive}
  {\color{black}\hrule height 0.5pt}
  \vspace{\sizefour}
  {#2}
  }
  \end{addmargin}
}

\newcommand{\subchap}[3]{
  \vspace{0.2em}
  {\fontsize{1em}{1em}\fontspec[Path = fonts/]{CrimsonText-Roman} #1} \hfill {\fontsize{0.95em}{0.95em}\fontspec[Path = fonts/]{CrimsonText-Roman} #2}
  {#3}
  \vspace{1pt}
}
